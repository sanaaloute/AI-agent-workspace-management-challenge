# ============================================================================
# AI File Agent configuration — every value is read by agent/config.py.
# Copy to .env and fill in. Nothing here is required for the UI to BOOT,
# but LLM_API_KEY is needed for agent runs to succeed.
# ============================================================================

# --- LLM provider -------------------------------------------------------------
# Exactly four variables configure the LLM. Supported providers:
#   openai | openrouter | ollama
# LLM_PROVIDER selects the default endpoint and model from the PROVIDERS map
# in agent/config.py; LLM_BASE_URL / LLM_MODEL only override those defaults.

LLM_PROVIDER=openai
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Example: OpenAI (defaults: https://api.openai.com/v1, gpt-4o-mini)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key-here

# Example: OpenRouter (defaults: https://openrouter.ai/api/v1, openai/gpt-4o-mini)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-your-openrouter-key-here
# LLM_MODEL=anthropic/claude-sonnet-4

# Example: Ollama Cloud — the HOSTED API at ollama.com, NOT a local daemon
# (defaults: https://ollama.com/v1, qwen3:8b)
# LLM_PROVIDER=ollama
# LLM_API_KEY=your-ollama-cloud-key-here

# Optional OpenRouter attribution headers (only used with LLM_PROVIDER=openrouter):
# OPENROUTER_REFERER=https://your-site.example
# OPENROUTER_TITLE=AI File Agent

# --- Agent loop ----------------------------------------------------------------
# Max tool-calling steps per run (default 15):
# MAX_STEPS=15
# Per-session token budget for the web demo; a run aborts gracefully when
# exceeded (default 200000):
# TOKEN_BUDGET=200000
# Per-request LLM timeout in seconds (default 120). The SDK default is 600s
# with retries, which makes a hung provider look like a frozen agent:
# LLM_TIMEOUT=120

# --- Paths ----------------------------------------------------------------------
# Defaults: ./workspace and ./workspace_original (resolved from the repo root).
# If you change these, keep the docker-compose volume mounts in sync.
# WORKSPACE_DIR=./workspace
# WORKSPACE_ORIGINAL_DIR=./workspace_original

# --- Server (bare metal) ---------------------------------------------------------
# Used by `python ui/server.py`. In docker-compose the host-side port mapping
# also reads PORT (container always listens on 8000).
# HOST=0.0.0.0
# PORT=8000
